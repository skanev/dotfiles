#!/usr/bin/env zsh

# herdr-core starts each pane's shell through sh -c wrappers of its own, so a
# fresh pane arrives at SHLVL=3 (and the exact number is herdr's to change).
# The first interactive shell in a pane records its level, and the prompt
# counts nesting from there. Herdr panes carry HC_TERMINAL_ID, older builds HERDR_ENV=1.
if [[ -n $HC_TERMINAL_ID || -n $HERDR_ENV ]] && [[ ! -v DOTFILES_HERDR_SHLVL ]]; then
  export DOTFILES_HERDR_SHLVL=$SHLVL
fi

prompt_zsh_level () {
  local base=$SHLVL

  if [[ -v DOTFILES_STARTX_USED ]]; then
    base=$((base - DOTFILES_STARTX_USED + 1))
  fi

  if [[ -v DOTFILES_HERDR_SHLVL ]]; then
    base=$((base - DOTFILES_HERDR_SHLVL + 1))
  elif [[ -n $TMUX ]]; then
    # the tmux server inherits SHLVL=1 from the shell that started it,
    # so its panes start at 2
    base=$((base - 1))
  fi

  if [[ $TERM_PROGRAM == vscode ]]; then
    base=0
  fi

  if (( base > 1 )); then
    printf '∎'%.0s {2..$base}
  fi

  # This is a leftover from before, tweak it later
  #if [[ $TERM_PROGRAM == vscode ]]; then
    #if [[ $SHLVL > 4 ]]; then
      #printf '∎'%.0s {5..$SHLVL}
    #fi
    #return
  #fi

  #if [[ -n $TMUX && $SHLVL > 2 ]]; then
    #printf '∎'%.0s {3..$SHLVL}
  #elif [[ -z $TMUX && $TERM_PROGRAM == "vscode" ]]; then
    #printf '∎'%.0s {3..$SHLVL}
  #elif [[ -z $TMUX && $SHLVL > 1 ]]; then
    #printf '∎'%.0s {2..$SHLVL}
  #fi
}

prompt_current_context () {
  if [[ -n $c_current[name] ]]; then
    print " (${c_current[name]})"
  fi
}

if [[ -n $T3CODE_PROJECT_ROOT ]]; then
  prompt_arrow_color=$fg_bold[black]
else
  prompt_arrow_color=$fg_bold[white]
fi

# Use a distinct arrow when reached over SSH; local arrow stays →
if [[ -n $SSH_CONNECTION ]]; then
  prompt_remote_arrow='»'
else
  prompt_remote_arrow='→'
fi

PROMPT='%(#.%{$fg_bold[yellow]%}.%{$prompt_arrow_color%})%(?..%{$fg_bold[red]%})$(prompt_zsh_level)%(#.∷.${prompt_remote_arrow})%{$reset_color%} '
unset prompt_arrow_color
RPROMPT='%(1j.%{$fg_bold[magenta]%}⦗%j⦘ .)%{$fg_bold[green]%}%c%{$fg_bold[white]%}:%{$fg_bold[blue]%}%m %{$fg_bold[red]%}$(vcprompt -f "[%b%m%u]")%{$reset_color%}%{$fg_bold[yellow]%}$(prompt_current_context)%{$reset_color%}'
PROMPT_EOL_MARK="%{${fg_bold[yellow]}%}¶%{$reset_color%}"
PS2=$'%{\e[38;5;240m%}…%{$reset_color%} '

case "$ITERM_PROFILE" in
  Beamer)
    PROMPT='➔ '
    RPROMPT=''
    ;;
  tkn)
    RPROMPT=''
    ;;
esac

if [[ -n $EMACS ]]; then
  PROMPT='$ '
fi
